<?xml version="1.0"?>

<launch>

  <!-- Address and port of the Vicon DataStream server. There is no useful
       default: an address belonging to one installation is unreachable
       everywhere else, and the node then blocks with nothing to indicate the
       host is simply wrong. Pass it explicitly:

         roslaunch vicon_bridge vicon.launch datastream_hostport:=<host>:801
  -->
  <arg name="datastream_hostport" default="localhost:801"/>
  <!-- Fixed vicon world frame -->
  <arg name="vicon_world_frame" default="/vicon/world"/>

	<node pkg="vicon_bridge" type="vicon_bridge" name="vicon" output="screen" >
		<param name="stream_mode" value="ServerPush"/>
    <param name="datastream_hostport" value="$(arg datastream_hostport)"/>
		<param name="tf_ref_frame_id" value="$(arg vicon_world_frame)"/>
	</node>

</launch>
